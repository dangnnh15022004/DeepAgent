# ===========================================
# Python / virtualenv
# ===========================================
# Root venv (Linux/macOS native dev)
venv/
venv-*/
.venv/
.venv-*/
.python-version

# Generated bytecode & caches
__pycache__/
*.py[cod]
*$py.class
*.so

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Distribution / build artifacts
build/
dist/
*.egg-info/
*.egg
.eggs/

# ===========================================
# Editors / OS
# ===========================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===========================================
# Secrets & local config
# ===========================================
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# ===========================================
# Logs & runtime data
# ===========================================
*.log
logs/
*.pid

# ===========================================
# Streamlit playground (isolated subdir)
# ===========================================
web_dev_test/venv/
web_dev_test/__pycache__/
web_dev_test/**/__pycache__/

# ===========================================
# Misc
# ===========================================
*.tmp
*.bak
